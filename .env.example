# Bot token from the Discord Developer Portal (Bot tab).
DISCORD_TOKEN=

# Optional. Paste a server ID to register slash commands immediately.
# Without this, new commands can take up to an hour to appear.
GUILD_ID=

# How often /watch refreshes the status message, in seconds (30-3600).
WATCH_INTERVAL=60

# Optional. Docker Compose sets this to /data/watches.json.
# WATCHES_PATH=
